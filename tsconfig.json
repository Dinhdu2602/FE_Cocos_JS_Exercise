{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext", // or CommonJS/ESNext depending on your setup
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "allowImportingTsExtensions": true,
  }
}